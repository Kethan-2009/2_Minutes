# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Where the app is served. Used to build email confirmation links.
# Locally this is fine as-is; on Vercel it is inferred from VERCEL_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Anthropic — used by the daily check-in. Not needed yet.
# ANTHROPIC_API_KEY=
