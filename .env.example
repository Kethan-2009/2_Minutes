# Supabase — safe to expose, the anon key is public by design and
# protected by row-level security.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Must match the port the dev server actually runs on, and must match
# Supabase Authentication > URL Configuration, or email links break.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. No NEXT_PUBLIC_ prefix: that would ship the key to every
# visitor's browser.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
